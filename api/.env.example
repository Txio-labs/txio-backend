MONGO_URI=mongodb://localhost:27017/txio
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
SESSION_KEY_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
RUST_LOG=debug
# Reserved admin emails (cannot self-register). Grant privilege with:
#   cargo run -p txio-api --bin bootstrap_admin -- --email admin@txio.io --password '...'
# Admin checks use User.is_admin, not live JWT email matching.
ADMIN_EMAILS=
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE
PORT=8000
FRONTEND_URL=http://localhost:3000
# This deployment's own public base URL. Used to build the redirect_uri sent
# to OAuth providers — must exactly match what's registered in each
# provider's app settings (e.g. https://api.txio.io).
BACKEND_URL=http://localhost:8000
SUI_CLI_EMAIL=user@example.com

# OAuth (optional — leaving either provider's pair unset disables that
# provider's login/connect button rather than failing to start).
# Google: console.cloud.google.com > APIs & Services > Credentials.
# Authorized redirect URI: {BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers > OAuth Apps.
# Authorization callback URL: {BACKEND_URL}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Browser session cookie (HttpOnly). Defaults suit production over HTTPS with
# the app and API on the same registrable domain (e.g. txio.xyz / api.txio.xyz).
# Local http://localhost development: COOKIE_SECURE=false
# App and API on different sites: COOKIE_SAMESITE=None (requires Secure)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=.txio.xyz
